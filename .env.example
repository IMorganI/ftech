# Скопируй в .env и поправь под себя. Сам .env в репозиторий не попадает.
DATABASE_URL=postgres://ftech:ftech@localhost:5432/ftech
# Ключ шифрования секретов в базе. Сгенерировать: openssl rand -base64 32
ENCRYPTION_KEY=
# Адрес, по которому сервер доступен снаружи (для ссылок на оплату и вебхуков)
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=600
# Мок-провайдер со страницей оплаты — только для разработки
MOCK_PROVIDER_ENABLED=true
# Секрет подписи вебхуков мок-провайдера (для аккаунтов с credentials_ref = MOCK)
PROVIDER_SECRET_MOCK=
# Через сколько секунд сверка сама спрашивает провайдера о статусе платежа
RECONCILE_AFTER_SEC=60
# Уведомления в Telegram (необязательно): токен от @BotFather, chat_id — через npm run telegram:setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
