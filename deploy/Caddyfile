# HTTPS-сертификат Let's Encrypt выпускается и продлевается сам.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	# Учебные страницы провайдеров на боевом сервере не нужны (и выключены в приложении).
	@sandbox path /mock-provider/* /testpay*
	respond @sandbox 404

	reverse_proxy app:3000 {
		header_up X-Forwarded-For {remote_host}
	}
	log {
		output stdout
		format json
	}
}
