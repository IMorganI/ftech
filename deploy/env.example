# Настройки сервера: скопируй в /opt/ftech/.env, chmod 600. В git этот файл не попадает.

# Домен этого стенда (DNS A-запись → IP сервера) и почта для Let's Encrypt
DOMAIN=pay.example.com
ACME_EMAIL=you@example.com

# Образ из GitHub Container Registry; IMAGE_TAG задаёт выкладка (коммит)
IMAGE=ghcr.io/imorgani/ftech
IMAGE_TAG=latest

# Пароль базы (контейнер db в этом же compose): openssl rand -hex 24  — только буквы и цифры
DB_PASSWORD=

# openssl rand -base64 32 — храни копию в менеджере паролей: без ключа зашифрованные ключи провайдеров не прочитать
ENCRYPTION_KEY=
PUBLIC_BASE_URL=https://pay.example.com
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_PER_IP_PER_MINUTE=3000
RECONCILE_AFTER_SEC=60
MOCK_PROVIDER_ENABLED=false

# Уведомления в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Бэкапы (scripts в /opt/ftech/deploy): пароль шифрования и куда выгружать (имя remote из rclone config)
BACKUP_PASSPHRASE=
BACKUP_REMOTE=backup:ftech-backups/prod
